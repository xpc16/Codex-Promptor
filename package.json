{
  "name": "codex-promptor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "vite --config config/vite.config.ts build && tsc -p config/tsconfig.server.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p config/tsconfig.client.json --noEmit && tsc -p config/tsconfig.server.json --noEmit",
    "test": "vitest --config config/vitest.config.ts run",
    "test:watch": "vitest --config config/vitest.config.ts",
    "check:codex": "node --import tsx scripts/check-codex-compat.mjs",
    "migrate:legacy-history": "node --import tsx scripts/migrate-legacy-history.mjs"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "fastify": "^5.4.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.0",
    "write-file-atomic": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
